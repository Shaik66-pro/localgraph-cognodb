{
  "name": "localgraph-cognodb",
  "version": "1.0.0",
  "description": "Local Business Discovery & Recommendation Network backed by CognoDB",
  "main": "backend/src/server.js",
  "scripts": {
    "build:frontend": "cd frontend && npm install && npm run build",
    "build": "npm run build:frontend",
    "start": "node backend/src/server.js",
    "preprocess": "node scripts/preprocess.js",
    "seed": "node scripts/seed.js",
    "test:db": "node backend/src/tests/test-db.js",
    "start:backend": "node backend/src/server.js",
    "start:frontend": "cd frontend && npm run dev",
    "dev": "concurrently \"npm run start:backend\" \"npm run start:frontend\""
  },
  "keywords": [
    "graph-database",
    "cognodb",
    "neo4j",
    "yelp",
    "cypher",
    "express",
    "react"
  ],
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "neo4j-driver": "^5.23.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
